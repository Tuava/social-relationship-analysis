DATABASE_URL=postgres://sra:sra@127.0.0.1:5432/social_relationship_analysis?sslmode=disable
HTTP_ADDR=127.0.0.1:8000
JWT_SECRET=replace-with-a-long-random-secret
SRA_CONFIG_ENCRYPTION_KEY=64-hex-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
OBJECT_ROOT=../data/objects
# Set this only when NapCat returns local file paths that should be archived.
NAPCAT_MEDIA_ROOT=
NAPCAT_OPENAPI_PATH=internal/collectors/napcat/openapi-4.18.18.json
# 0 means unlimited. Set only when this deployment needs an explicit safety policy.
GRAPH_MAX_DEPTH=0
GRAPH_BUILD_MAX_NODES=0
GRAPH_BUILD_MAX_EDGES=0
GRAPH_BUILD_MAX_EVENTS=0
GRAPH_VIEW_MAX_NODES=0
GRAPH_EXPAND_MAX_NODES=0
# Route search defaults are explicit and deployment-configurable.
ROUTING_DEFAULT_MAX_HOPS=4
ROUTING_DEFAULT_MAX_PATHS=3
ROUTING_DEFAULT_LARGE_GROUP_THRESHOLD=100
# 0 means unlimited. Non-zero values are reported in every route response.
ROUTING_MAX_HOPS=0
ROUTING_MAX_PATHS=0
ROUTING_MAX_GRAPH_NODES=0
ROUTING_MAX_FRONTIER_NEIGHBORS=0
ROUTING_MAX_GROUP_CO_MEMBERS=0
ROUTING_MAX_GROUP_MEMBERSHIPS=0
CORS_ORIGIN=http://localhost:5173

# Optional independent limited SQL login. Never use the application owner here.
# See docs/sql-reader.md; empty disables only sra_sql_query.
SRA_SQL_DATABASE_URL=
# Optional prebuilt frontend directory served by the API process.
FRONTEND_DIST=
